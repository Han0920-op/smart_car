<?xml version="1.0"?>
<sdf version="1.6">
  <world name="patrol">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- The near face is at x = 1.80 m, directly ahead of the spawn pose. -->
    <model name="front_obstacle">
      <static>true</static>
      <pose>2.0 0 0.30 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry><box><size>0.40 0.50 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.50 0.60</size></box></geometry>
          <material><ambient>0.75 0.20 0.12 1</ambient><diffuse>0.75 0.20 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="left_obstacle">
      <static>true</static>
      <pose>0.90 1.50 0.30 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.60</size></box></geometry>
          <material><ambient>0.15 0.55 0.30 1</ambient><diffuse>0.15 0.55 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="right_obstacle">
      <static>true</static>
      <pose>1.60 -1.20 0.30 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry><box><size>0.50 0.40 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.40 0.60</size></box></geometry>
          <material><ambient>0.77 0.55 0.16 1</ambient><diffuse>0.77 0.55 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
